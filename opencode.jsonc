{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "uv run pytest *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "uv run sloperator.py *",
      "effect": "allow"
    },
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow"
    },
  ]
}