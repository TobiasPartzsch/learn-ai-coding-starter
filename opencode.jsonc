{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  // Format Python files with the project's Ruff after every write/edit.
  // `ruff` is not on PATH globally, so go through `uv run`.
  "formatter": {
    "ruff": {
      "command": ["uv", "run", "ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"],
    },
  },
  "agents": {
    "explore": {
      "tools": {
        "read": true,
        "search": true,
        "list": true,
        "bash": false
      } // Disallow shell/bash
    },
  },
  "watcher": {
    "ignore": [
      "logs/**"
    ],
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 10000 },
    "buffer": 20000,
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "uv run pytest *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "uv run ruff check *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "uv run ruff format *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "uv run ty check *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "uv run sloperator.py *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "opencode debug *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "mktemp *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "cat *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "grep *",
      "effect": "allow",
    },
    // Scratch files under /tmp/opencode. These are already allowed by the
    // default policy, but stating them makes the intent explicit.
    {
      "action": "external_directory",
      "resource": "/tmp/opencode/*",
      "effect": "allow",
    },
    {
      "action": "read",
      "resource": "/tmp/opencode/*",
      "effect": "allow",
    },
    {
      "action": "edit",
      "resource": "/tmp/opencode/*",
      "effect": "allow",
    },
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow",
    },
    // Ask before the agent loads the example-writing workflow.
    {
      "action": "skill",
      "resource": "create-test-program",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "echo *",
      "effect": "allow",
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny",
    },
  ]
}