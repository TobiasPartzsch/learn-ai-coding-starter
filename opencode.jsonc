{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "instructions": [
    "TOOL USAGE POLICY:",
    "- Always prefer native tools ('read', 'glob', 'grep', 'edit') over shell commands for file inspection and navigation.",
    "- Never invoke 'cat', 'head', 'tail', 'grep', 'find', or 'ls' via the shell tool.",
    "- Reserve the 'shell' tool exclusively for non-native tasks: test runners (pytest), linters (ruff), typecheckers (ty), and VCS (git)."
  ],
  "agents": {
    "explore": {
      "tools": {
        "read": true,
        "search": true,
        "list": true,
        "bash": false
      } // Disallow shell/bash
    },
  },
  "watcher": {
    "ignore": [
      "logs/**"
    ],
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 10000 },
    "buffer": 20000,
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "uv run pytest *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "uv run ruff check *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "uv run ruff format *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "uv run ty check *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "uv run sloperator.py *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "opencode debug *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "mktemp *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "cat *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "grep *",
      "effect": "allow",
    },
    // Scratch files under /tmp/opencode. These are already allowed by the
    // default policy, but stating them makes the intent explicit.
    {
      "action": "external_directory",
      "resource": "/tmp/opencode/*",
      "effect": "allow",
    },
    {
      "action": "read",
      "resource": "/tmp/opencode/*",
      "effect": "allow",
    },
    {
      "action": "edit",
      "resource": "/tmp/opencode/*",
      "effect": "allow",
    },
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "echo *",
      "effect": "allow",
    },
  ]
}